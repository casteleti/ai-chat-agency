{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concierge.example/schemas/generative-ui.v1.json",
  "title": "Approved Generative UI Descriptor",
  "$defs": {
    "QuickActions": {
      "type": "object", "additionalProperties": false, "required": ["options"],
      "properties": {
        "prompt": {"type": "string", "maxLength": 300},
        "options": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "label"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string", "maxLength": 80},
              "description": {"type": "string", "maxLength": 180}
            }
          }
        }
      }
    },
    "Insight": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "summary", "confidence", "preliminary"],
      "properties": {
        "title": {"type": "string", "maxLength": 120},
        "summary": {"type": "string", "maxLength": 800},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidenceIds": {"type": "array", "items": {"type": "string"}},
        "preliminary": {"type": "boolean"}
      }
    },
    "Briefing": {
      "type": "object", "additionalProperties": false,
      "required": ["briefingId", "version", "sections", "editable"],
      "properties": {
        "briefingId": {"type": "string", "format": "uuid"},
        "version": {"type": "integer", "minimum": 1},
        "sections": {"type": "array", "maxItems": 10, "items": {"type": "object"}},
        "editable": {"type": "boolean"}
      }
    },
    "OpportunityMap": {
      "type": "object", "additionalProperties": false,
      "required": ["mapId", "version", "items", "preliminary"],
      "properties": {
        "mapId": {"type": "string", "format": "uuid"},
        "version": {"type": "integer", "minimum": 1},
        "items": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "object"}},
        "preliminary": {"const": true}
      }
    },
    "MeetingPicker": {
      "type": "object", "additionalProperties": false,
      "required": ["meetingTypeId", "timeZone", "slots"],
      "properties": {
        "meetingTypeId": {"type": "string", "format": "uuid"},
        "timeZone": {"type": "string"},
        "slots": {
          "type": "array", "maxItems": 12,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["slotToken", "start", "end"],
            "properties": {
              "slotToken": {"type": "string"},
              "start": {"type": "string", "format": "date-time"},
              "end": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    },
    "Progress": {
      "type": "object", "additionalProperties": false, "required": ["label", "steps"],
      "properties": {
        "label": {"type": "string", "maxLength": 120},
        "steps": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["label", "status"],
            "properties": {
              "label": {"type": "string", "maxLength": 120},
              "status": {"enum": ["PENDING", "ACTIVE", "DONE", "FAILED"]}
            }
          }
        }
      }
    },
    "Text": {
      "type": "object", "additionalProperties": false, "required": ["markdown"],
      "properties": {
        "markdown": {"type": "string", "maxLength": 4000, "description": "Subset renderer only: no raw HTML/scripts."},
        "citations": {
          "type": "array", "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["label", "sourceId"],
            "properties": {"label": {"type": "string", "maxLength": 120}, "sourceId": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "QuestionGroup": {
      "type": "object", "additionalProperties": false, "required": ["questions"],
      "properties": {
        "prompt": {"type": "string", "maxLength": 300},
        "questions": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "label"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string", "maxLength": 200},
              "placeholder": {"type": "string", "maxLength": 100}
            }
          }
        }
      }
    },
    "ApprovedRecord": {
      "type": "object", "additionalProperties": false, "required": ["recordId"],
      "properties": {
        "recordId": {"type": "string", "format": "uuid", "description": "Server resolves canonical title/summary/price from this ID; model text never overrides them."},
        "relevanceNote": {"type": "string", "maxLength": 300}
      }
    },
    "WebsiteDiagnostic": {
      "type": "object", "additionalProperties": false, "required": ["url", "fetchedAt", "observations", "limitations"],
      "properties": {
        "url": {"type": "string", "format": "uri", "maxLength": 2048},
        "fetchedAt": {"type": "string", "format": "date-time"},
        "observations": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["area", "summary"],
            "properties": {
              "area": {"enum": ["MESSAGING", "CONVERSION", "AI_READINESS", "STRUCTURE"]},
              "summary": {"type": "string", "maxLength": 500}
            }
          }
        },
        "limitations": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "maxLength": 250}}
      }
    },
    "MeetingConfirmation": {
      "type": "object", "additionalProperties": false, "required": ["meetingId", "status", "start", "end", "timeZone", "reference"],
      "properties": {
        "meetingId": {"type": "string", "format": "uuid"},
        "status": {"enum": ["SCHEDULED", "PENDING_SYNC"]},
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "timeZone": {"type": "string"},
        "reference": {"type": "string", "maxLength": 100}
      }
    },
    "SupportTicket": {
      "type": "object", "additionalProperties": false, "required": ["reference", "status"],
      "properties": {
        "reference": {"type": "string", "maxLength": 100},
        "status": {"type": "string", "maxLength": 60},
        "severity": {"enum": ["SEV_1", "SEV_2", "SEV_3", "SEV_4"]}
      }
    },
    "FileRequest": {
      "type": "object", "additionalProperties": false, "required": ["purpose", "acceptedMimeTypes", "maxSizeBytes", "consentRequired"],
      "properties": {
        "purpose": {"type": "string", "maxLength": 200},
        "acceptedMimeTypes": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "maxLength": 100}},
        "maxSizeBytes": {"type": "integer", "minimum": 1},
        "maxFiles": {"type": "integer", "minimum": 1, "maximum": 10, "default": 1},
        "consentRequired": {"const": true}
      }
    },
    "Timeline": {
      "type": "object", "additionalProperties": false, "required": ["events", "source", "asOf"],
      "properties": {
        "title": {"type": "string", "maxLength": 120},
        "events": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["label", "timestamp"],
            "properties": {
              "label": {"type": "string", "maxLength": 200},
              "timestamp": {"type": "string", "format": "date-time"},
              "sourceId": {"type": "string"}
            }
          }
        },
        "source": {"type": "string", "maxLength": 200},
        "asOf": {"type": "string", "format": "date-time"}
      }
    },
    "Metric": {
      "type": "object", "additionalProperties": false, "required": ["label", "value", "definition", "source", "asOf"],
      "properties": {
        "label": {"type": "string", "maxLength": 120},
        "value": {"type": ["number", "string"]},
        "unit": {"type": "string", "maxLength": 30},
        "definition": {"type": "string", "maxLength": 300},
        "source": {"type": "string", "maxLength": 200},
        "asOf": {"type": "string", "format": "date-time"},
        "trend": {"enum": ["UP", "DOWN", "FLAT"]}
      }
    },
    "HumanHandoff": {
      "type": "object", "additionalProperties": false, "required": ["handoffId", "status", "reference"],
      "properties": {
        "handoffId": {"type": "string", "format": "uuid"},
        "status": {"enum": ["PENDING", "ROUTED", "HUMAN_ACTIVE", "COMPLETED"]},
        "reference": {"type": "string", "maxLength": 100},
        "expectedResponse": {"type": "string", "maxLength": 200, "description": "Server-computed from SLA config only; never model-authored."}
      }
    },
    "Cta": {
      "type": "object", "additionalProperties": false, "required": ["label", "actionId"],
      "properties": {
        "label": {"type": "string", "maxLength": 80},
        "description": {"type": "string", "maxLength": 200},
        "actionId": {"type": "string", "format": "uuid", "description": "Must also appear in the descriptor's top-level actionIds array. Not enforceable by JSON Schema alone (no cross-field/sibling-array support in this draft) -- see validate-generative-ui.mjs#validateActionIdReferences, which must run as a second pass after schema validation."}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "type", "data"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1, "maxLength": 100},
    "type": {"enum": ["text", "quick_actions", "insight", "question_group", "briefing", "opportunity_map", "service", "case_study", "website_diagnostic", "meeting_picker", "meeting_confirmation", "support_ticket", "file_request", "progress", "timeline", "metric", "human_handoff", "cta"]},
    "data": {"type": "object"},
    "actionIds": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "analyticsKey": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "expiresAt": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "quick_actions"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/QuickActions"}}}},
    {"if": {"properties": {"type": {"const": "insight"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/Insight"}}}},
    {"if": {"properties": {"type": {"const": "briefing"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/Briefing"}}}},
    {"if": {"properties": {"type": {"const": "opportunity_map"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/OpportunityMap"}}}},
    {"if": {"properties": {"type": {"const": "meeting_picker"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/MeetingPicker"}}}},
    {"if": {"properties": {"type": {"const": "progress"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/Progress"}}}},
    {"if": {"properties": {"type": {"const": "text"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/Text"}}}},
    {"if": {"properties": {"type": {"const": "question_group"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/QuestionGroup"}}}},
    {"if": {"properties": {"type": {"const": "service"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/ApprovedRecord"}}}},
    {"if": {"properties": {"type": {"const": "case_study"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/ApprovedRecord"}}}},
    {"if": {"properties": {"type": {"const": "website_diagnostic"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/WebsiteDiagnostic"}}}},
    {"if": {"properties": {"type": {"const": "meeting_confirmation"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/MeetingConfirmation"}}}},
    {"if": {"properties": {"type": {"const": "support_ticket"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/SupportTicket"}}}},
    {"if": {"properties": {"type": {"const": "file_request"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/FileRequest"}}}},
    {"if": {"properties": {"type": {"const": "timeline"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/Timeline"}}}},
    {"if": {"properties": {"type": {"const": "metric"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/Metric"}}}},
    {"if": {"properties": {"type": {"const": "human_handoff"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/HumanHandoff"}}}},
    {"if": {"properties": {"type": {"const": "cta"}}, "required": ["type"]}, "then": {"properties": {"data": {"$ref": "#/$defs/Cta"}}}}
  ]
}
