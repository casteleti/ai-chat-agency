# APP
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3001
DEFAULT_TENANT_SLUG=agency
DEFAULT_LOCALE=pt-BR
LOG_LEVEL=debug

# DATABASE
DATABASE_URL=postgresql://concierge:concierge@localhost:5432/concierge
DATABASE_POOL_MAX=10
DATABASE_SSL_MODE=disable

# REDIS (ephemeral only)
REDIS_URL=redis://localhost:6379

# AI — use real secrets only in local secret store/deployment environment
AI_PRIMARY_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL_FAST=gpt-5.6-luna
AI_MODEL_STANDARD=gpt-5.6-terra
AI_MODEL_REASONING=gpt-5.6-sol
AI_EMBEDDING_MODEL=
AI_MAX_CONCURRENT_GENERATIONS=20
AI_DAILY_COST_LIMIT_USD=25

# AUTH
BETTER_AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
ANONYMOUS_SESSION_SECRET=
MAGIC_LINK_TTL_SECONDS=900

# STORAGE
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=concierge-private
R2_SIGNED_URL_TTL_SECONDS=300

# CRM
CRM_PROVIDER=fake
CRM_WRITES_ENABLED=false
CRM_API_TOKEN=
CRM_WEBHOOK_SECRET=

# CALENDAR
CALENDAR_PROVIDER=fake
CALENDAR_WRITES_ENABLED=false
CALENDAR_API_TOKEN=
CALENDAR_WEBHOOK_SECRET=
DEFAULT_TIMEZONE=America/Sao_Paulo

# EMAIL / NOTIFICATIONS
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=concierge@example.invalid
HANDOFF_DESTINATION=

# SUPPORT / CHANNELS
SUPPORT_PROVIDER=internal
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# ANALYTICS
POSTHOG_KEY=
POSTHOG_HOST=
ANALYTICS_ENABLED=false

# OBSERVABILITY
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-business-concierge
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
SENTRY_DSN=

# SECURITY
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ENCRYPTION_KEY_CURRENT=
FILE_SCAN_PROVIDER=disabled
FILE_MAX_BYTES=10485760

# FEATURE FLAGS (safe defaults)
AI_CHAT_ENABLED=false
NEW_BUSINESS_ENABLED=false
SUPPORT_ENABLED=false
GENERATIVE_UI_ENABLED=false
WEBSITE_ANALYSIS_ENABLED=false
FILE_UPLOAD_ENABLED=false
HUMAN_HANDOFF_ENABLED=false
VOICE_ENABLED=false
CRM_WRITES_ENABLED=false
CALENDAR_WRITES_ENABLED=false
